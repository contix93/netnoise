# Copia in /opt/netnoise/netnoise.env (pm2) o /etc/netnoise.env (systemd) e adatta.

# IP del NAS in LAN: il servizio non deve essere raggiungibile da Internet
BIND=192.168.1.5
PORT=8080

# Consigliato: il frontend si collega a ws://nas:8080/ws?token=...
TOKEN=

# Frontend compilato da servire sulla stessa porta (opzionale)
# STATIC_DIR=/opt/netnoise/web/.output/public

# Percorso completo: /usr/sbin non è nel PATH degli utenti normali (pm2)
CONNTRACK_BIN=/usr/sbin/conntrack

# Cadenze (ms)
POLL_MS=500
TICK_MS=100

# Limiti
MAX_FLOWS=400
MAX_NEW_PER_TICK=100

# Peer da ignorare. Aggiungi le reti Docker se non vuoi vedere il traffico host↔container:
# EXCLUDE_CIDRS=127.0.0.0/8,::1/128,172.17.0.0/16,172.18.0.0/16
EXCLUDE_CIDRS=127.0.0.0/8,::1/128

# Interfacce per il throughput totale (vuoto = quella della default route)
# IFACES=enp3s0

# Anonimizzazione dei peer: hash | none
ANON=hash
# Salt fisso per avere gli stessi nodi dopo un riavvio (genera con: openssl rand -hex 32)
ANON_SALT=

IPV6=true
LOG_LEVEL=info

# Registrazione per il replay in sviluppo
# pm2:     RECORD_FILE=/opt/netnoise/rec.ndjson
# systemd: RECORD_FILE=/var/lib/netnoise/rec.ndjson (scrivibile grazie a StateDirectory)
